# 二进制
/bin/
*.exe

# ONNX Runtime 依赖（make ort 下载，不入库）
/third_party/

# 用户自有模型（保留官方 yolov8n.onnx 案例权重）
/models/best.onnx
/models/*best*.onnx
*.tmp.jpg
*.tmp.png

# 校验数据集（coco128-seg 等，通过 make coco128-seg 下载，不入库）
/testdata/

# 运行期数据集（采集池 + 回流训练集 + 版本清单，均为数据/产物，不入库）
/dataset/

# 运行期产物（推理/校验/视频预览的临时目录，不入库）
/runs/
